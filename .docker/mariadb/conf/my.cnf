# Конфиг MariaDB. Зеркало .docker/mysql/conf/my.cnf с поправкой на три опции,
# которых в MariaDB нет — см. комментарии ниже. Остальное совпадает,
# правки в одном конфиге имеет смысл переносить во второй.
[mysqld]
# Bitrix
   init_connect='SET collation_connection = utf8mb4_unicode_ci'
   character-set-server = utf8mb4
   sql-mode=""
   collation-server = utf8mb4_unicode_ci
   explicit_defaults_for_timestamp = 1
   transaction-isolation ='READ-COMMITTED'

   #Глобальные буферы
   #(key_buffer_size + tmp_table_size + innodb_buffer_pool_size + innodb_log_buffer_size + query_cache_size)

# MyISAM
   key_buffer_size   = 10M

#TABLE cache
   open_files_limit         = 100000
   table_open_cache         = 2000
   table_definition_cache   = 2000

# Temp Tables
   tmp_table_size           = 128M
   max_heap_table_size      = 128M

# Timeouts
   lock_wait_timeout        = 100
   wait_timeout             = 300
   innodb_lock_wait_timeout = 30
# У MySQL это max_execution_time в миллисекундах, у MariaDB — max_statement_time
# в секундах. 6000 мс из mysql-конфига = 6 с.
   max_statement_time       = 6

# Buffers
   join_buffer_size = 1M
   read_rnd_buffer_size = 1M
   sort_buffer_size  = 1M
   bulk_insert_buffer_size = 16M

# InnoDB
# innodb_buffer_pool_instances в MariaDB нет — пул перестал делиться на инстансы
# начиная с 10.6, сервер не стартует с этой опцией
  innodb_flush_log_at_trx_commit = 2
  innodb_flush_method = O_DIRECT
  innodb_buffer_pool_size = 2G
  innodb_log_buffer_size = 64M
# Аналог innodb_redo_log_capacity из MySQL 8.0.30+
  innodb_log_file_size = 128M

  sync_binlog = 0
[client]
    default-character-set = utf8mb4
