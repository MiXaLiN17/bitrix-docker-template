# Please Note:
# In PHP Versions <= 7.4 MySQL8 is not supported due to lacking pdo support

# Будет как префикс к контейнерам
COMPOSE_PROJECT_NAME=test

# Опциональные сервисы. Пусто — поднимается только базовый стек (nginx, php, mysql).
# sphinx — добавляет контейнер полнотекстового поиска Sphinx.
# Переключается через make sphinx-enable / make sphinx-disable
COMPOSE_PROFILES=

# Устанавливаем логи
WEB_SERVER_LOG_DIR=./logs/webserver
APP_LOG_DIR=./logs/app
MYSQL_LOG_DIR=./logs/mysql
SPHINX_LOG_DIR=./logs/sphinx

# MySQL пароль рута в докере
MYSQL_ROOT_PASSWORD=docker
MYSQL_USER=docker
MYSQL_PASSWORD=docker
MYSQL_DATABASE=docker

# Указываем порты локальной машины
# Помнить, что данные порты могут быть уже заняты, поэтому если что меняем на любой другой, но тогда нужен прокси
# Или тушим апач перед запуском
# 80 порт занимает апач
HOST_MACHINE_UNSECURE_HOST_PORT=80
HOST_MACHINE_SECURE_HOST_PORT=443

# Порт для фронтенд dev сервера
HOST_MACHINE_FRONTEND_PORT=5173

# Локльный порт, который слушает БД. Выключил, чтобы не мешало
HOST_MACHINE_MYSQL_PORT=3306

# Локальный порт SphinxQL. Тоже выключен: Битрикс ходит в sphinx:9306 внутри сети докера
HOST_MACHINE_SPHINX_PORT=9306

# Версия php проекта
PHP_VERSION=8.4

# ID пользователя
UID=1000
GID=1000
